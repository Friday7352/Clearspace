<!-- Clearspace | Neon HUD theme (experimental).
     NEW (experimental themes): a sci-fi display - near-black violet, cyan outlines, hot-pink accent, a
     condensed technical font, square corners, faint scanlines over the main window, and glowing line icons
     (ThemeIcons, style Neon). Same keys as Dark.xaml plus the extras at the bottom. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Base"          Color="#FF07060F" />
    <SolidColorBrush x:Key="Surface"       Color="#FF0D0B1E" />
    <SolidColorBrush x:Key="Overlay"       Color="#FF120F2B" />
    <SolidColorBrush x:Key="Hover"         Color="#2600F0FF" />
    <SolidColorBrush x:Key="Pressed"       Color="#4D00F0FF" />
    <SolidColorBrush x:Key="Selected"      Color="#FF3A0F4A" />
    <SolidColorBrush x:Key="Line"          Color="#FF2B2A6B" />
    <SolidColorBrush x:Key="LineFaint"     Color="#FF191740" />

    <!-- Outlines of buttons, menus and cards (EdgeRaised) and of text boxes and the file list (EdgeSunken). -->
    <SolidColorBrush x:Key="EdgeRaised"    Color="#FF00F0FF" />
    <SolidColorBrush x:Key="EdgeSunken"    Color="#FF00F0FF" />

    <!-- Text -->
    <SolidColorBrush x:Key="Ink"           Color="#FFEAF6FF" />
    <SolidColorBrush x:Key="InkMuted"      Color="#FF9DB2E0" />
    <SolidColorBrush x:Key="InkFaint"      Color="#FF737BC0" />
    <SolidColorBrush x:Key="InkDisabled"   Color="#FF3F427A" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent"        Color="#FFFF2BD6" />
    <SolidColorBrush x:Key="AccentSoft"    Color="#33FF2BD6" />
    <SolidColorBrush x:Key="AccentWash"    Color="#20FF2BD6" />
    <SolidColorBrush x:Key="AccentInk"     Color="#FF07060F" />   <!-- text on a solid accent fill -->

    <!-- Status -->
    <SolidColorBrush x:Key="Danger"        Color="#FFFF6C88" />
    <SolidColorBrush x:Key="Good"          Color="#FF39FFB0" />
    <SolidColorBrush x:Key="Warn"          Color="#FFFFE14D" />
    <SolidColorBrush x:Key="Bad"           Color="#FFFF5C7A" />
    <SolidColorBrush x:Key="Quiet"         Color="#FF9DB2E0" />

    <!-- Small fills -->
    <SolidColorBrush x:Key="ThumbRest"     Color="#6600F0FF" />   <!-- scroll bar -->
    <SolidColorBrush x:Key="ThumbHover"    Color="#B300F0FF" />
    <SolidColorBrush x:Key="Tint"          Color="#1A00F0FF" />   <!-- status bar chips -->
    <SolidColorBrush x:Key="ChipHover"     Color="#FF1C1740" />   <!-- a project-strip chip under the pointer -->
    <SolidColorBrush x:Key="Divider"       Color="#6600F0FF" />   <!-- menu separators -->
    <SolidColorBrush x:Key="RowAlt"        Color="#0600F0FF" />   <!-- every other row in Music folders -->
    <SolidColorBrush x:Key="Track"         Color="#3300F0FF" />   <!-- drive usage bar background -->
    <SolidColorBrush x:Key="SliderRail"    Color="#4D00F0FF" />
    <SolidColorBrush x:Key="Well"          Color="#1400F0FF" />   <!-- behind a tile's picture -->
    <SolidColorBrush x:Key="BadgeFill"     Color="#E607060F" />   <!-- badges drawn over a tile's picture -->
    <SolidColorBrush x:Key="NavFill"       Color="#CC07060F" />   <!-- previous / next in the photo viewer -->
    <SolidColorBrush x:Key="Scrim"         Color="#FA07060F" />   <!-- photo viewer backdrop -->
    <SolidColorBrush x:Key="CardFill"      Color="#F5120F2B" />   <!-- tooltips and hover cards -->
    <SolidColorBrush x:Key="CardEdge"      Color="#FFFF2BD6" />
    <SolidColorBrush x:Key="Ground3D"      Color="#FF120F2B" />   <!-- floor of the 3D disk usage views -->

    <!-- The highlighted row of a menu -->
    <SolidColorBrush x:Key="MenuHover"       Color="#4000F0FF" />
    <SolidColorBrush x:Key="MenuHoverInk"    Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MenuHoverMuted"  Color="#FF9DB2E0" />
    <SolidColorBrush x:Key="MenuHoverFaint"  Color="#FF737BC0" />
    <SolidColorBrush x:Key="MenuHoverAccent" Color="#FFFF2BD6" />

    <!-- Fonts -->
    <FontFamily x:Key="UIFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="SerifFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Lucida Console</FontFamily>

    <!-- Corner sizes (R8 = "what used to be an 8px corner") -->
    <CornerRadius x:Key="R2">0</CornerRadius>
    <CornerRadius x:Key="R3">0</CornerRadius>
    <CornerRadius x:Key="R4">0</CornerRadius>
    <CornerRadius x:Key="R5">0</CornerRadius>
    <CornerRadius x:Key="R6">0</CornerRadius>
    <CornerRadius x:Key="R7">0</CornerRadius>
    <CornerRadius x:Key="R8">0</CornerRadius>
    <CornerRadius x:Key="R9">0</CornerRadius>
    <CornerRadius x:Key="R10">0</CornerRadius>
    <CornerRadius x:Key="R12">0</CornerRadius>
    <CornerRadius x:Key="RPlayerBar">0</CornerRadius>

    <!-- Title bar: near-black with cyan text (Windows 11 only; Windows 10 keeps its own title bar). -->
    <Color x:Key="Theme.CaptionColor">#FF07060F</Color>
    <Color x:Key="Theme.CaptionTextColor">#FF00F0FF</Color>

    <!-- Scanlines: one faint dark line every three, laid over the whole main window (off in Defaults.xaml). -->
    <DrawingBrush x:Key="OverlayFill" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute"
                  Viewbox="0,0,3,3" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#38000000">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,2,3,1" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <Visibility x:Key="OverlayVisibility">Visible</Visibility>

</ResourceDictionary>
