    <!-- Text -->
    <SolidColorBrush x:Key="Ink"           Color="#FFEDEAE0" />
    <SolidColorBrush x:Key="InkMuted"      Color="#FFB4B1AA" />
    <SolidColorBrush x:Key="InkFaint"      Color="#FF8E8C88" />
    <SolidColorBrush x:Key="InkDisabled"   Color="#FF5F5E62" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent"        Color="#FF8FB4FF" />
    <SolidColorBrush x:Key="AccentSoft"    Color="#338FB4FF" />
    <SolidColorBrush x:Key="AccentWash"    Color="#1F8FB4FF" />
    <SolidColorBrush x:Key="AccentInk"     Color="#FF14161C" />   <!-- text on a solid accent fill -->

    <!-- Status -->
    <SolidColorBrush x:Key="Danger"        Color="#FFFF8A80" />
    <SolidColorBrush x:Key="Good"          Color="#FF8BD48E" />
    <SolidColorBrush x:Key="Warn"          Color="#FFFFC46B" />
    <SolidColorBrush x:Key="Bad"           Color="#FFFF8A80" />
    <SolidColorBrush x:Key="Quiet"         Color="#FFB4B1AA" />

    <!-- Small fills -->
    <SolidColorBrush x:Key="ThumbRest"     Color="#40FFFFFF" />   <!-- scroll bar -->
    <SolidColorBrush x:Key="ThumbHover"    Color="#66FFFFFF" />
    <SolidColorBrush x:Key="Tint"          Color="#14FFFFFF" />   <!-- status bar chips -->
    <LinearGradientBrush x:Key="ChipHover" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2EFFEB3B" Offset="0.0" />
        <GradientStop Color="#3FFFEB3B" Offset="0.25" />
        <GradientStop Color="#34FFEB3B" Offset="0.5" />
        <GradientStop Color="#45FFEB3B" Offset="0.75" />
        <GradientStop Color="#3AFFEB3B" Offset="1.0" />
    </LinearGradientBrush>   <!-- a project-strip chip under the pointer -->
    <SolidColorBrush x:Key="Divider"       Color="#4D9A9A9A" />   <!-- menu separators -->
    <SolidColorBrush x:Key="RowAlt"        Color="#08FFFFFF" />   <!-- every other row in Music folders -->
    <SolidColorBrush x:Key="Track"         Color="#24FFFFFF" />   <!-- drive usage bar background -->
    <SolidColorBrush x:Key="SliderRail"    Color="#40FFFFFF" />
    <SolidColorBrush x:Key="Well"          Color="#0FFFFFFF" />   <!-- behind a tile's picture -->
    <SolidColorBrush x:Key="BadgeFill"     Color="#E61D1D21" />   <!-- badges drawn over a tile's picture -->
    <SolidColorBrush x:Key="NavFill"       Color="#CC2B2B31" />   <!-- previous / next in the photo viewer -->
    <SolidColorBrush x:Key="Scrim"         Color="#F5141417" />   <!-- photo viewer backdrop -->
    <SolidColorBrush x:Key="CardFill"      Color="#FF3B3721" />   <!-- tooltips and hover cards -->
    <SolidColorBrush x:Key="CardEdge"      Color="#FF7A6F33" />
    <SolidColorBrush x:Key="Ground3D"      Color="#FF27272C" />   <!-- floor of the 3D disk usage views -->

    <!-- The highlighted row of a menu -->
    <LinearGradientBrush x:Key="MenuHover" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#34FFEB3B" Offset="0.0" />
        <GradientStop Color="#45FFEB3B" Offset="0.25" />
        <GradientStop Color="#3AFFEB3B" Offset="0.5" />
        <GradientStop Color="#4BFFEB3B" Offset="0.75" />
        <GradientStop Color="#3FFFEB3B" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuHoverInk"    Color="#FFEDEAE0" />
    <SolidColorBrush x:Key="MenuHoverMuted"  Color="#FFDAD7CE" />
    <SolidColorBrush x:Key="MenuHoverFaint"  Color="#FFC4C1B9" />
    <SolidColorBrush x:Key="MenuHoverAccent" Color="#FFC6D9FF" />

    <!-- Fonts -->
    <FontFamily x:Key="UIFont">Ink Free, Segoe Print, Comic Sans MS, Segoe UI</FontFamily>
    <FontFamily x:Key="SerifFont">Ink Free, Segoe Print, Comic Sans MS, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Ink Free, Segoe Print, Comic Sans MS, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Corner sizes (R8 = "what used to be an 8px corner") -->
    <CornerRadius x:Key="R2">2</CornerRadius>
    <CornerRadius x:Key="R3">3,2,4,2</CornerRadius>
    <CornerRadius x:Key="R4">5,3,4,2</CornerRadius>
    <CornerRadius x:Key="R5">6,3,5,4</CornerRadius>
    <CornerRadius x:Key="R6">7,4,8,5</CornerRadius>
    <CornerRadius x:Key="R7">8,5,9,4</CornerRadius>
    <CornerRadius x:Key="R8">10,5,12,6</CornerRadius>
    <CornerRadius x:Key="R9">11,6,9,7</CornerRadius>
    <CornerRadius x:Key="R10">12,7,13,6</CornerRadius>
    <CornerRadius x:Key="R12">14,8,16,7</CornerRadius>
    <CornerRadius x:Key="RPlayerBar">0,0,15,6</CornerRadius>

    <!-- Title bar: the paper colour (Windows 11 only; Windows 10 keeps its own title bar). -->
    <Color x:Key="Theme.CaptionColor">#FF1D1D21</Color>
    <Color x:Key="Theme.CaptionTextColor">#FFEDEAE0</Color>

    <!-- The window background is a pattern, so this is the one flat colour code uses where it needs one. -->
    <Color x:Key="Theme.BaseColor">#FF1D1D21</Color>

    <!-- The spiral binding down the left edge of the main window, and the room the page leaves for it
         (both off in Defaults.xaml). -->
    <DrawingBrush x:Key="BindingFill" TileMode="Tile" Viewport="0,0,30,30" ViewportUnits="Absolute"
                  Viewbox="0,0,30,30" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- the shadow where the page meets the binding -->
                <GeometryDrawing Brush="#59000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,3,30" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- a punched hole -->
                <GeometryDrawing Brush="#FF09090B">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="17,15" RadiusX="4.5" RadiusY="4.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- the wire coming round the edge into the hole, with a highlight along its top -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF7D818B" Thickness="4.2" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="-4,10.5" EndPoint="16,14" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFDCDFE5" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="-4,9.4" EndPoint="15,12.8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <Visibility x:Key="BindingVisibility">Visible</Visibility>
    <Thickness x:Key="PageInset">30,0,0,0</Thickness>

    <!-- Sticky-note tooltips sit a little crooked (straight in Defaults.xaml). -->
    <RotateTransform x:Key="NoteTilt" Angle="-1.3" />

    <!-- Highlighter over black paper is a dull gold, so the quieter text inside a selected row is lifted to
         stay readable. ThemeService merges every "SelectedRow.X" key into a selected row as key X. -->
    <SolidColorBrush x:Key="SelectedRow.InkMuted"   Color="#FFE2DFD6" />
    <SolidColorBrush x:Key="SelectedRow.InkFaint"   Color="#FFCDCAC2" />
    <SolidColorBrush x:Key="SelectedRow.Accent"     Color="#FFCFE0FF" />

</ResourceDictionary>
