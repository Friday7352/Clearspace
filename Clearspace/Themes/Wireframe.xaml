<!-- Clearspace | Wireframe theme (experimental).
     NEW (experimental themes): outlines only - panels are the same graphite as the window, so only their
     white outlines show; one colour throughout; square corners; every icon a line drawing
     (ThemeIcons, style Line, drawn in this theme's Ink colour). Same keys as Dark.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Base"          Color="#FF101418" />
    <SolidColorBrush x:Key="Surface"       Color="#FF101418" />
    <SolidColorBrush x:Key="Overlay"       Color="#FF151A20" />
    <SolidColorBrush x:Key="Hover"         Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Pressed"       Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Selected"      Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Line"          Color="#FF5E6E7E" />
    <SolidColorBrush x:Key="LineFaint"     Color="#FF2C3640" />

    <!-- Outlines of buttons, menus and cards (EdgeRaised) and of text boxes and the file list (EdgeSunken). -->
    <SolidColorBrush x:Key="EdgeRaised"    Color="#FFE6EDF3" />
    <SolidColorBrush x:Key="EdgeSunken"    Color="#FFE6EDF3" />

    <!-- Text -->
    <SolidColorBrush x:Key="Ink"           Color="#FFE6EDF3" />
    <SolidColorBrush x:Key="InkMuted"      Color="#FF9FB0C0" />
    <SolidColorBrush x:Key="InkFaint"      Color="#FF76889A" />
    <SolidColorBrush x:Key="InkDisabled"   Color="#FF465564" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent"        Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentSoft"    Color="#26FFFFFF" />
    <SolidColorBrush x:Key="AccentWash"    Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="AccentInk"     Color="#FF101418" />   <!-- text on a solid accent fill -->

    <!-- Status -->
    <SolidColorBrush x:Key="Danger"        Color="#FFF0A8A0" />
    <SolidColorBrush x:Key="Good"          Color="#FFB8F0C8" />
    <SolidColorBrush x:Key="Warn"          Color="#FFF0E0A8" />
    <SolidColorBrush x:Key="Bad"           Color="#FFF0A8A0" />
    <SolidColorBrush x:Key="Quiet"         Color="#FF9FB0C0" />

    <!-- Small fills -->
    <SolidColorBrush x:Key="ThumbRest"     Color="#40FFFFFF" />   <!-- scroll bar -->
    <SolidColorBrush x:Key="ThumbHover"    Color="#80FFFFFF" />
    <SolidColorBrush x:Key="Tint"          Color="#14FFFFFF" />   <!-- status bar chips -->
    <SolidColorBrush x:Key="ChipHover"     Color="#26FFFFFF" />   <!-- a project-strip chip under the pointer -->
    <SolidColorBrush x:Key="Divider"       Color="#FF5E6E7E" />   <!-- menu separators -->
    <SolidColorBrush x:Key="RowAlt"        Color="#05FFFFFF" />   <!-- every other row in Music folders -->
    <SolidColorBrush x:Key="Track"         Color="#26FFFFFF" />   <!-- drive usage bar background -->
    <SolidColorBrush x:Key="SliderRail"    Color="#40FFFFFF" />
    <SolidColorBrush x:Key="Well"          Color="#00000000" />   <!-- behind a tile's picture -->
    <SolidColorBrush x:Key="BadgeFill"     Color="#E6101418" />   <!-- badges drawn over a tile's picture -->
    <SolidColorBrush x:Key="NavFill"       Color="#CC101418" />   <!-- previous / next in the photo viewer -->
    <SolidColorBrush x:Key="Scrim"         Color="#FA101418" />   <!-- photo viewer backdrop -->
    <SolidColorBrush x:Key="CardFill"      Color="#FF101418" />   <!-- tooltips and hover cards -->
    <SolidColorBrush x:Key="CardEdge"      Color="#FFE6EDF3" />
    <SolidColorBrush x:Key="Ground3D"      Color="#FF151A20" />   <!-- floor of the 3D disk usage views -->

    <!-- The highlighted row of a menu -->
    <SolidColorBrush x:Key="MenuHover"       Color="#26FFFFFF" />
    <SolidColorBrush x:Key="MenuHoverInk"    Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MenuHoverMuted"  Color="#FF9FB0C0" />
    <SolidColorBrush x:Key="MenuHoverFaint"  Color="#FF76889A" />
    <SolidColorBrush x:Key="MenuHoverAccent" Color="#FFFFFFFF" />

    <!-- Fonts -->
    <FontFamily x:Key="UIFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SerifFont">Cascadia Mono, Consolas, Lucida Console</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Lucida Console</FontFamily>

    <!-- Corner sizes (R8 = "what used to be an 8px corner") -->
    <CornerRadius x:Key="R2">0</CornerRadius>
    <CornerRadius x:Key="R3">0</CornerRadius>
    <CornerRadius x:Key="R4">0</CornerRadius>
    <CornerRadius x:Key="R5">0</CornerRadius>
    <CornerRadius x:Key="R6">0</CornerRadius>
    <CornerRadius x:Key="R7">0</CornerRadius>
    <CornerRadius x:Key="R8">0</CornerRadius>
    <CornerRadius x:Key="R9">0</CornerRadius>
    <CornerRadius x:Key="R10">0</CornerRadius>
    <CornerRadius x:Key="R12">0</CornerRadius>
    <CornerRadius x:Key="RPlayerBar">0</CornerRadius>

    <!-- Title bar: the same graphite (Windows 11 only; Windows 10 keeps its own title bar). -->
    <Color x:Key="Theme.CaptionColor">#FF101418</Color>
    <Color x:Key="Theme.CaptionTextColor">#FFE6EDF3</Color>

</ResourceDictionary>
