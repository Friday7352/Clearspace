<!-- Clearspace | Dark theme (the default look).
     NEW (themes): every colour, font and corner size the app uses lives in a theme file like this one.
     App.xaml merges this file at startup; ThemeService swaps it for Light.xaml or Retro.xaml when you
     pick another theme in Settings. To add a theme: copy this file, change the values, keep every key,
     and add an entry to ThemeService.Themes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Base"          Color="#FF1A1917" />
    <SolidColorBrush x:Key="Surface"       Color="#FF232220" />
    <SolidColorBrush x:Key="Overlay"       Color="#FF2A2826" />
    <SolidColorBrush x:Key="Hover"         Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Pressed"       Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Selected"      Color="#FF34322D" />
    <SolidColorBrush x:Key="Line"          Color="#FF33302C" />
    <SolidColorBrush x:Key="LineFaint"     Color="#FF2A2825" />

    <!-- Borders of raised things (buttons, menus, cards) and sunken things (text boxes, the file list).
         Kept as their own keys so a theme can outline these differently from ordinary lines. -->
    <SolidColorBrush x:Key="EdgeRaised"    Color="#FF33302C" />
    <SolidColorBrush x:Key="EdgeSunken"    Color="#FF33302C" />

    <!-- Text -->
    <SolidColorBrush x:Key="Ink"           Color="#FFECE9E3" />
    <SolidColorBrush x:Key="InkMuted"      Color="#FF9C968D" />
    <SolidColorBrush x:Key="InkFaint"      Color="#FF6E6862" />
    <SolidColorBrush x:Key="InkDisabled"   Color="#FF4E4A45" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent"        Color="#FFD3A15F" />
    <SolidColorBrush x:Key="AccentSoft"    Color="#33D3A15F" />
    <SolidColorBrush x:Key="AccentWash"    Color="#20D3A15F" />
    <SolidColorBrush x:Key="AccentInk"     Color="#FF1A1917" />   <!-- text on a solid accent fill -->

    <!-- Status -->
    <SolidColorBrush x:Key="Danger"        Color="#FFE39482" />
    <SolidColorBrush x:Key="Good"          Color="#FF70B284" />
    <SolidColorBrush x:Key="Warn"          Color="#FFD3A15F" />
    <SolidColorBrush x:Key="Bad"           Color="#FFD65F54" />
    <SolidColorBrush x:Key="Quiet"         Color="#FF9C968D" />

    <!-- Small fills -->
    <SolidColorBrush x:Key="ThumbRest"     Color="#26FFFFFF" />   <!-- scroll bar -->
    <SolidColorBrush x:Key="ThumbHover"    Color="#40FFFFFF" />
    <SolidColorBrush x:Key="Tint"          Color="#14FFFFFF" />   <!-- status bar chips -->
    <SolidColorBrush x:Key="ChipHover"     Color="#FF34322D" />   <!-- a project-strip chip under the pointer -->
    <SolidColorBrush x:Key="Divider"       Color="#14FFFFFF" />   <!-- menu separators -->
    <SolidColorBrush x:Key="RowAlt"        Color="#05FFFFFF" />   <!-- every other row in Music folders -->
    <SolidColorBrush x:Key="Track"         Color="#18FFFFFF" />   <!-- drive usage bar background -->
    <SolidColorBrush x:Key="SliderRail"    Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Well"          Color="#14000000" />   <!-- behind a tile's picture -->
    <SolidColorBrush x:Key="BadgeFill"     Color="#B3141312" />   <!-- badges drawn over a tile's picture -->
    <SolidColorBrush x:Key="NavFill"       Color="#99141312" />   <!-- previous / next in the photo viewer -->
    <SolidColorBrush x:Key="Scrim"         Color="#F2141312" />   <!-- photo viewer backdrop -->
    <SolidColorBrush x:Key="CardFill"      Color="#F4232220" />   <!-- tooltips and hover cards -->
    <SolidColorBrush x:Key="CardEdge"      Color="#FF3A3732" />
    <SolidColorBrush x:Key="Ground3D"      Color="#FF2A2825" />   <!-- floor of the 3D disk usage views -->

    <!-- The highlighted row of a menu -->
    <SolidColorBrush x:Key="MenuHover"       Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="MenuHoverInk"    Color="#FFECE9E3" />
    <SolidColorBrush x:Key="MenuHoverMuted"  Color="#FF9C968D" />
    <SolidColorBrush x:Key="MenuHoverFaint"  Color="#FF4E4A45" />
    <SolidColorBrush x:Key="MenuHoverAccent" Color="#FFD3A15F" />

    <!-- Fonts -->
    <FontFamily x:Key="UIFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SerifFont">Source Serif 4, Source Serif Pro, Newsreader, Spectral, Cambria, Georgia</FontFamily>
    <FontFamily x:Key="DisplayFont">Source Serif 4, Newsreader, Cambria, Georgia</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Corner sizes (R8 = "what used to be an 8px corner") -->
    <CornerRadius x:Key="R2">2</CornerRadius>
    <CornerRadius x:Key="R3">3</CornerRadius>
    <CornerRadius x:Key="R4">4</CornerRadius>
    <CornerRadius x:Key="R5">5</CornerRadius>
    <CornerRadius x:Key="R6">6</CornerRadius>
    <CornerRadius x:Key="R7">7</CornerRadius>
    <CornerRadius x:Key="R8">8</CornerRadius>
    <CornerRadius x:Key="R9">9</CornerRadius>
    <CornerRadius x:Key="R10">10</CornerRadius>
    <CornerRadius x:Key="R12">12</CornerRadius>
    <CornerRadius x:Key="RPlayerBar">0,0,11,11</CornerRadius>

</ResourceDictionary>
