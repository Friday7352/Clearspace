<!-- Clearspace | DOS Commander theme (experimental).
     NEW (experimental themes): the two-panel file managers of the DOS years - blue screen, cyan names, yellow
     accent, cyan frame lines, a cyan cursor bar with black text, monospace everywhere, square corners, a
     function-key bar along the bottom of the main window, and single bold marks instead of icons
     (ThemeIcons, style Mark). Same keys as Dark.xaml plus the extras at the bottom. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Base"          Color="#FF0000AA" />
    <SolidColorBrush x:Key="Surface"       Color="#FF0000AA" />
    <SolidColorBrush x:Key="Overlay"       Color="#FF000080" />
    <SolidColorBrush x:Key="Hover"         Color="#3355FFFF" />
    <SolidColorBrush x:Key="Pressed"       Color="#5555FFFF" />
    <SolidColorBrush x:Key="Selected"      Color="#FF00AAAA" />
    <SolidColorBrush x:Key="Line"          Color="#FF55FFFF" />
    <SolidColorBrush x:Key="LineFaint"     Color="#FF2A2AD4" />

    <!-- Outlines of buttons, menus and cards (EdgeRaised) and of text boxes and the file list (EdgeSunken). -->
    <SolidColorBrush x:Key="EdgeRaised"    Color="#FF55FFFF" />
    <SolidColorBrush x:Key="EdgeSunken"    Color="#FF55FFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="Ink"           Color="#FF55FFFF" />
    <SolidColorBrush x:Key="InkMuted"      Color="#FFC8C8C8" />
    <SolidColorBrush x:Key="InkFaint"      Color="#FF9C9CFF" />
    <SolidColorBrush x:Key="InkDisabled"   Color="#FF6C6CD8" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent"        Color="#FFFFFF55" />
    <SolidColorBrush x:Key="AccentSoft"    Color="#33FFFF55" />
    <SolidColorBrush x:Key="AccentWash"    Color="#20FFFF55" />
    <SolidColorBrush x:Key="AccentInk"     Color="#FF000000" />   <!-- text on a solid accent fill -->

    <!-- Status -->
    <SolidColorBrush x:Key="Danger"        Color="#FFFF7777" />
    <SolidColorBrush x:Key="Good"          Color="#FF55FF55" />
    <SolidColorBrush x:Key="Warn"          Color="#FFFFFF55" />
    <SolidColorBrush x:Key="Bad"           Color="#FFFF7777" />
    <SolidColorBrush x:Key="Quiet"         Color="#FFC8C8C8" />

    <!-- Small fills -->
    <SolidColorBrush x:Key="ThumbRest"     Color="#FF00AAAA" />   <!-- scroll bar -->
    <SolidColorBrush x:Key="ThumbHover"    Color="#FF55FFFF" />
    <SolidColorBrush x:Key="Tint"          Color="#2255FFFF" />   <!-- status bar chips -->
    <SolidColorBrush x:Key="ChipHover"     Color="#FF2A2AD4" />   <!-- a project-strip chip under the pointer -->
    <SolidColorBrush x:Key="Divider"       Color="#FF55FFFF" />   <!-- menu separators -->
    <SolidColorBrush x:Key="RowAlt"        Color="#00000000" />   <!-- every other row in Music folders -->
    <SolidColorBrush x:Key="Track"         Color="#3355FFFF" />   <!-- drive usage bar background -->
    <SolidColorBrush x:Key="SliderRail"    Color="#FF00AAAA" />
    <SolidColorBrush x:Key="Well"          Color="#33000000" />   <!-- behind a tile's picture -->
    <SolidColorBrush x:Key="BadgeFill"     Color="#FF000000" />   <!-- badges drawn over a tile's picture -->
    <SolidColorBrush x:Key="NavFill"       Color="#FF000000" />   <!-- previous / next in the photo viewer -->
    <SolidColorBrush x:Key="Scrim"         Color="#FA0000AA" />   <!-- photo viewer backdrop -->
    <SolidColorBrush x:Key="CardFill"      Color="#FF000000" />   <!-- tooltips and hover cards -->
    <SolidColorBrush x:Key="CardEdge"      Color="#FF55FFFF" />
    <SolidColorBrush x:Key="Ground3D"      Color="#FF000080" />   <!-- floor of the 3D disk usage views -->

    <!-- The highlighted row of a menu -->
    <SolidColorBrush x:Key="MenuHover"       Color="#FF00AAAA" />
    <SolidColorBrush x:Key="MenuHoverInk"    Color="#FF000000" />
    <SolidColorBrush x:Key="MenuHoverMuted"  Color="#FF000000" />
    <SolidColorBrush x:Key="MenuHoverFaint"  Color="#FF003C3C" />
    <SolidColorBrush x:Key="MenuHoverAccent" Color="#FF000000" />

    <!-- Fonts -->
    <FontFamily x:Key="UIFont">Perfect DOS VGA 437, Cascadia Mono, Consolas, Lucida Console</FontFamily>
    <FontFamily x:Key="SerifFont">Perfect DOS VGA 437, Cascadia Mono, Consolas, Lucida Console</FontFamily>
    <FontFamily x:Key="DisplayFont">Perfect DOS VGA 437, Cascadia Mono, Consolas, Lucida Console</FontFamily>
    <FontFamily x:Key="MonoFont">Perfect DOS VGA 437, Cascadia Mono, Consolas, Lucida Console</FontFamily>

    <!-- Corner sizes (R8 = "what used to be an 8px corner") -->
    <CornerRadius x:Key="R2">0</CornerRadius>
    <CornerRadius x:Key="R3">0</CornerRadius>
    <CornerRadius x:Key="R4">0</CornerRadius>
    <CornerRadius x:Key="R5">0</CornerRadius>
    <CornerRadius x:Key="R6">0</CornerRadius>
    <CornerRadius x:Key="R7">0</CornerRadius>
    <CornerRadius x:Key="R8">0</CornerRadius>
    <CornerRadius x:Key="R9">0</CornerRadius>
    <CornerRadius x:Key="R10">0</CornerRadius>
    <CornerRadius x:Key="R12">0</CornerRadius>
    <CornerRadius x:Key="RPlayerBar">0</CornerRadius>

    <!-- Title bar: the same blue (Windows 11 only; Windows 10 keeps its own title bar). -->
    <Color x:Key="Theme.CaptionColor">#FF0000AA</Color>
    <Color x:Key="Theme.CaptionTextColor">#FFFFFFFF</Color>

    <!-- Show the function-key bar along the bottom of the main window (off in Defaults.xaml). -->
    <Visibility x:Key="FunctionKeysVisibility">Visible</Visibility>

    <!-- A selected row is the cyan cursor bar, so text inside it turns black. ThemeService merges every "SelectedRow.X" key into a selected row as key X. -->
    <SolidColorBrush x:Key="SelectedRow.Ink" Color="#FF000000" />
    <SolidColorBrush x:Key="SelectedRow.InkMuted" Color="#FF002A2A" />
    <SolidColorBrush x:Key="SelectedRow.InkFaint" Color="#FF003C3C" />
    <SolidColorBrush x:Key="SelectedRow.Accent" Color="#FF000000" />
    <SolidColorBrush x:Key="SelectedRow.Base" Color="#FF00AAAA" />
    <SolidColorBrush x:Key="SelectedRow.BadgeFill" Color="#FF00AAAA" />

</ResourceDictionary>
