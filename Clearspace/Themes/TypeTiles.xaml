<!-- Clearspace | Type tiles theme (experimental).
     NEW (experimental themes): no pictures - every file is a flat coloured tile with its extension written
     on it, colour-coded by kind (ThemeIcons, style Tile). The rest is a plain cool-grey dark look with a
     blue accent and a sans-serif face for names, so the tiles are what stand out. Same keys as Dark.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Base"          Color="#FF14161B" />
    <SolidColorBrush x:Key="Surface"       Color="#FF1B1E25" />
    <SolidColorBrush x:Key="Overlay"       Color="#FF22262F" />
    <SolidColorBrush x:Key="Hover"         Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Pressed"       Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Selected"      Color="#FF2C3340" />
    <SolidColorBrush x:Key="Line"          Color="#FF2E333D" />
    <SolidColorBrush x:Key="LineFaint"     Color="#FF23272F" />

    <!-- Outlines of buttons, menus and cards (EdgeRaised) and of text boxes and the file list (EdgeSunken). -->
    <SolidColorBrush x:Key="EdgeRaised"    Color="#FF2E333D" />
    <SolidColorBrush x:Key="EdgeSunken"    Color="#FF2E333D" />

    <!-- Text -->
    <SolidColorBrush x:Key="Ink"           Color="#FFECEFF4" />
    <SolidColorBrush x:Key="InkMuted"      Color="#FF9AA3B2" />
    <SolidColorBrush x:Key="InkFaint"      Color="#FF6E7786" />
    <SolidColorBrush x:Key="InkDisabled"   Color="#FF48505C" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent"        Color="#FF6C9EFF" />
    <SolidColorBrush x:Key="AccentSoft"    Color="#336C9EFF" />
    <SolidColorBrush x:Key="AccentWash"    Color="#206C9EFF" />
    <SolidColorBrush x:Key="AccentInk"     Color="#FF0F1115" />   <!-- text on a solid accent fill -->

    <!-- Status -->
    <SolidColorBrush x:Key="Danger"        Color="#FFFF8A80" />
    <SolidColorBrush x:Key="Good"          Color="#FF6FCF97" />
    <SolidColorBrush x:Key="Warn"          Color="#FFF2C94C" />
    <SolidColorBrush x:Key="Bad"           Color="#FFEB6A6A" />
    <SolidColorBrush x:Key="Quiet"         Color="#FF9AA3B2" />

    <!-- Small fills -->
    <SolidColorBrush x:Key="ThumbRest"     Color="#26FFFFFF" />   <!-- scroll bar -->
    <SolidColorBrush x:Key="ThumbHover"    Color="#40FFFFFF" />
    <SolidColorBrush x:Key="Tint"          Color="#14FFFFFF" />   <!-- status bar chips -->
    <SolidColorBrush x:Key="ChipHover"     Color="#FF2C3340" />   <!-- a project-strip chip under the pointer -->
    <SolidColorBrush x:Key="Divider"       Color="#14FFFFFF" />   <!-- menu separators -->
    <SolidColorBrush x:Key="RowAlt"        Color="#05FFFFFF" />   <!-- every other row in Music folders -->
    <SolidColorBrush x:Key="Track"         Color="#18FFFFFF" />   <!-- drive usage bar background -->
    <SolidColorBrush x:Key="SliderRail"    Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Well"          Color="#14000000" />   <!-- behind a tile's picture -->
    <SolidColorBrush x:Key="BadgeFill"     Color="#B30F1115" />   <!-- badges drawn over a tile's picture -->
    <SolidColorBrush x:Key="NavFill"       Color="#990F1115" />   <!-- previous / next in the photo viewer -->
    <SolidColorBrush x:Key="Scrim"         Color="#F20F1115" />   <!-- photo viewer backdrop -->
    <SolidColorBrush x:Key="CardFill"      Color="#F522262F" />   <!-- tooltips and hover cards -->
    <SolidColorBrush x:Key="CardEdge"      Color="#FF3A404C" />
    <SolidColorBrush x:Key="Ground3D"      Color="#FF22262F" />   <!-- floor of the 3D disk usage views -->

    <!-- The highlighted row of a menu -->
    <SolidColorBrush x:Key="MenuHover"       Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="MenuHoverInk"    Color="#FFECEFF4" />
    <SolidColorBrush x:Key="MenuHoverMuted"  Color="#FF9AA3B2" />
    <SolidColorBrush x:Key="MenuHoverFaint"  Color="#FF48505C" />
    <SolidColorBrush x:Key="MenuHoverAccent" Color="#FF6C9EFF" />

    <!-- Fonts -->
    <FontFamily x:Key="UIFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SerifFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Corner sizes (R8 = "what used to be an 8px corner") -->
    <CornerRadius x:Key="R2">2</CornerRadius>
    <CornerRadius x:Key="R3">3</CornerRadius>
    <CornerRadius x:Key="R4">4</CornerRadius>
    <CornerRadius x:Key="R5">5</CornerRadius>
    <CornerRadius x:Key="R6">6</CornerRadius>
    <CornerRadius x:Key="R7">7</CornerRadius>
    <CornerRadius x:Key="R8">8</CornerRadius>
    <CornerRadius x:Key="R9">9</CornerRadius>
    <CornerRadius x:Key="R10">10</CornerRadius>
    <CornerRadius x:Key="R12">12</CornerRadius>
    <CornerRadius x:Key="RPlayerBar">0,0,11,11</CornerRadius>

    <!-- Title bar: the same dark grey (Windows 11 only; Windows 10 keeps its own title bar). -->
    <Color x:Key="Theme.CaptionColor">#FF14161B</Color>
    <Color x:Key="Theme.CaptionTextColor">#FFECEFF4</Color>

</ResourceDictionary>
