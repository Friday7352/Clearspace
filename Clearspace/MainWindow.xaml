<!-- Clearspace | Main window layout and templates.
     CHANGED (themes): colours, fonts and corner sizes are DynamicResource references into the active theme
     (Themes/*.xaml) and the colours that used to be written out here have theme keys. The theme picker is
     in the Settings menu. -->
<Window x:Class="Clearspace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clearspace"
        Height="800" Width="1280"
        MinHeight="500" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Base}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UIFont}"
        FontSize="12.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <GridView x:Key="DetailsView" x:Shared="False" ColumnHeaderContainerStyle="{StaticResource ColumnHeader}" />

        <GridViewColumn x:Key="Col.Name" x:Shared="False" Width="400" Header="Name">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Loaded="OnMusicRowLoaded"
                                    DataContextChanged="OnMusicRowDataContextChanged">
                            <!-- NEW (lock icons): small lock badge over the icon of a locked file or folder. -->
                            <Grid Margin="6,0,11,0">
                                <Image Source="{Binding Icon}"
                                       Width="16" Height="16"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,-5,-4"
                                        Width="11" Height="11"
                                        CornerRadius="5.5"
                                        Background="{DynamicResource Base}"
                                        ToolTip="{Binding LockToolTip}"
                                        Visibility="{Binding HasLockBadge, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="{Binding LockGlyph}"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="8"
                                               Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Name}"
                                       FontFamily="{DynamicResource SerifFont}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>

        <GridViewColumn x:Key="Col.DateModified" x:Shared="False" Width="180" Header="Date modified">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DateModifiedText}"
                                   Foreground="{DynamicResource InkMuted}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>

        <GridViewColumn x:Key="Col.Status" x:Shared="False" Width="52" Header="Status">
            <GridViewColumn.CellTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="{Binding CloudStatusText}">
                        <TextBlock Text="{Binding CloudStatusGlyph}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding CloudStatusBrush}" />
                    </StackPanel>
                </DataTemplate>
            </GridViewColumn.CellTemplate>
        </GridViewColumn>

        <GridViewColumn x:Key="Col.Type" x:Shared="False" Width="160" Header="Type">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding TypeName}"
                                   Foreground="{DynamicResource InkMuted}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>

        <GridViewColumn x:Key="Col.Size" x:Shared="False" Width="110" Header="Size">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding SizeText}"
                                   Foreground="{DynamicResource InkMuted}"
                                   Margin="0,0,14,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
        </GridViewColumn>

        <GridViewColumn x:Key="Col.Play" x:Shared="False" Width="46" Header="">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <Grid Margin="6,0,0,0"
                              Loaded="OnMusicRowLoaded"
                              DataContextChanged="OnMusicRowDataContextChanged">
                            <TextBlock Text="{Binding TrackNumberText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource InkFaint}"
                                       Typography.NumeralAlignment="Tabular">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsMouseOver}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Click="OnPlayTrackClick"
                                    ToolTip="Play in Clearspace"
                                    Content="&#xE768;">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TransportButton}">
                                        <Setter Property="Width" Value="26" />
                                        <Setter Property="Height" Value="26" />
                                        <Setter Property="FontSize" Value="10" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsAudio}" Value="True" />
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsMouseOver}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsAudio}" Value="True" />
                                                    <Condition Binding="{Binding IsNowPlaying}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsNowPlaying}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.Player.IsPlaying, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Setter Property="Content" Value="&#xE769;" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>

        <GridViewColumn x:Key="Col.Title" x:Shared="False" Width="330" Header="Title">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <!-- NEW (lock icons): small lock badge over the icon of a locked file or folder. -->
                            <Grid Margin="2,0,10,0">
                                <Image Source="{Binding Icon}"
                                       Width="16" Height="16"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,-5,-4"
                                        Width="11" Height="11"
                                        CornerRadius="5.5"
                                        Background="{DynamicResource Base}"
                                        ToolTip="{Binding LockToolTip}"
                                        Visibility="{Binding HasLockBadge, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="{Binding LockGlyph}"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="8"
                                               Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding DisplayTitle}"
                                       FontFamily="{DynamicResource SerifFont}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>

        <GridViewColumn x:Key="Col.Artist" x:Shared="False" Width="200" Header="Artist">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Artist}"
                                   Foreground="{DynamicResource InkMuted}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>

        <GridViewColumn x:Key="Col.Album" x:Shared="False" Width="200" Header="Album">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Foreground="{DynamicResource InkMuted}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Album}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter Property="Text" Value="Folder" />
                                            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>

        <GridViewColumn x:Key="Col.Length" x:Shared="False" Width="90" Header="Length">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DurationText}"
                                   Foreground="{DynamicResource InkMuted}"
                                   Margin="0,0,14,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
        </GridViewColumn>

        <GridViewColumn x:Key="Col.Track" x:Shared="False" Width="64" Header="Track">
            <GridViewColumn.CellTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding TrackNumberText}"
                               Foreground="{DynamicResource InkMuted}"
                               Margin="0,0,14,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                </DataTemplate>
            </GridViewColumn.CellTemplate>
        </GridViewColumn>

        <GridViewColumn x:Key="Col.DateCreated" x:Shared="False" Width="180" Header="Date created">
            <GridViewColumn.CellTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DateCreatedText}"
                               Foreground="{DynamicResource InkMuted}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                </DataTemplate>
            </GridViewColumn.CellTemplate>
        </GridViewColumn>

        <GridViewColumn x:Key="Col.Tags" x:Shared="False" Width="170" Header="Tags">
            <GridViewColumn.CellTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Tags}"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Brush}"
                                        CornerRadius="{DynamicResource R4}"
                                        Padding="6,1"
                                        Margin="0,0,4,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="10"
                                               Foreground="#FF1A1917" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </GridViewColumn.CellTemplate>
        </GridViewColumn>

        <!-- NEW (folder types, step 2): Git status of a file, or "Changes inside" for a folder (Code). -->
        <GridViewColumn x:Key="Col.Git" x:Shared="False" Width="120" Header="Git">
            <GridViewColumn.CellTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding GitStatusText}"
                               Foreground="{Binding GitStatusBrush}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </GridViewColumn.CellTemplate>
        </GridViewColumn>

        <!-- NEW (folder types, step 2): pixel size of images and videos, read when the row is shown. -->
        <GridViewColumn x:Key="Col.Dimensions" x:Shared="False" Width="120" Header="Dimensions">
            <GridViewColumn.CellTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DimensionsText}"
                               Foreground="{DynamicResource InkMuted}"
                               Margin="0,0,14,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"
                               Loaded="OnDimensionsCellLoaded"
                               DataContextChanged="OnDimensionsCellDataContextChanged" />
                </DataTemplate>
            </GridViewColumn.CellTemplate>
        </GridViewColumn>

        <!-- NEW (folder types, step 3): document authors and pages (Documents, Research). -->
        <GridViewColumn x:Key="Col.Authors" x:Shared="False" Width="200" Header="Authors">
            <GridViewColumn.CellTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Authors}"
                               Foreground="{DynamicResource InkMuted}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Authors}" />
                </DataTemplate>
            </GridViewColumn.CellTemplate>
        </GridViewColumn>

        <GridViewColumn x:Key="Col.Pages" x:Shared="False" Width="70" Header="Pages">
            <GridViewColumn.CellTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding PageCountText}"
                               Foreground="{DynamicResource InkMuted}"
                               Margin="0,0,14,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                </DataTemplate>
            </GridViewColumn.CellTemplate>
        </GridViewColumn>

        <!-- NEW (folder types, step 3): the site a download came from (Downloads). -->
        <GridViewColumn x:Key="Col.Source" x:Shared="False" Width="170" Header="Source">
            <GridViewColumn.CellTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding SourceText}"
                               Foreground="{DynamicResource InkMuted}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Loaded="OnSourceCellLoaded"
                               DataContextChanged="OnSourceCellDataContextChanged" />
                </DataTemplate>
            </GridViewColumn.CellTemplate>
        </GridViewColumn>

        <!-- NEW (folder types, step 2): a pinned or recent file in the project strip. -->
        <Style x:Key="ProjectChip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource EdgeRaised}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource R8}"
                                Padding="10,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- CHANGED (themes): own key; "Selected" is solid navy in Retro and would hide the text. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChipHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TileTemplate">
            <Grid Margin="6,10"
                  Loaded="OnTileLoaded"
                  DataContextChanged="OnTileDataContextChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding DataContext.TilePreviewAreaHeight, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Well}" CornerRadius="{DynamicResource R7}">
                    <Grid>
                        <Image Source="{Binding GridImage}"
                               Width="{Binding DataContext.TilePreviewSize, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                               Height="{Binding DataContext.TilePreviewSize, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               Margin="4"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- NEW (lock icons): lock badge in the tile's top-left corner. -->
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="6"
                                Padding="5,3"
                                CornerRadius="{DynamicResource R5}"
                                Background="{DynamicResource BadgeFill}"
                                ToolTip="{Binding LockToolTip}"
                                Visibility="{Binding HasLockBadge, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{Binding LockGlyph}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Accent}" />
                        </Border>

                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="6"
                                Padding="5,2"
                                CornerRadius="{DynamicResource R5}"
                                Background="{DynamicResource BadgeFill}"
                                ToolTip="{Binding CloudStatusText}"
                                Visibility="{Binding IsCloudItem, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{Binding CloudStatusGlyph}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="10"
                                       Foreground="{Binding CloudStatusBrush}" />
                        </Border>

                        <!-- NEW (folder types, step 3): a video's length on its tile. -->
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="6"
                                Padding="5,1"
                                CornerRadius="{DynamicResource R5}"
                                Background="{DynamicResource BadgeFill}"
                                Visibility="{Binding HasDuration, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{Binding DurationText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource Ink}"
                                       Typography.NumeralAlignment="Tabular" />
                        </Border>

                        <Button Click="OnViewPhotoClick"
                                Content="&#xE8B3;"
                                ToolTip="View in Clearspace"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,6,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Width" Value="28" />
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Background" Value="{DynamicResource BadgeFill}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsImageFile}" Value="True" />
                                                <Condition Binding="{Binding DataContext.IsPhotosProfile, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" Value="True" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsMouseOver}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="{Binding Name}"
                           FontFamily="{DynamicResource SerifFont}"
                           FontSize="12"
                           Margin="2,8,2,0"
                           MaxHeight="34"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Ink}" />

                <StackPanel Grid.Row="2"
                            Margin="4,2,4,1"
                            Visibility="{Binding IsDriveRoot, Converter={StaticResource BoolToVisible}}">
                    <ProgressBar Style="{StaticResource DriveUsageBar}"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding DriveUsagePercent, Mode=OneWay}"
                                 Foreground="{Binding DriveUsageBrush}" />
                    <TextBlock Text="{Binding SizeText}"
                               Margin="0,5,0,0"
                               FontSize="9.5"
                               TextAlignment="Center"
                               Foreground="{DynamicResource InkMuted}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- NEW (experimental themes): one entry of the DOS Commander function-key bar. Tag is the key,
             Content the action. -->
        <Style x:Key="FunctionKey" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{DynamicResource UIFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource InkMuted}"
                                       Margin="0,0,3,0"
                                       VerticalAlignment="Center" />
                            <Border x:Name="Label" Background="{DynamicResource MenuHover}" Padding="5,1">
                                <ContentPresenter TextElement.Foreground="{DynamicResource MenuHoverInk}" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- NEW (e-ink): everything in the window sits in this frame so one effect can be laid over all of it (the
         E-reader theme's panel look, set from MainWindow.EInk.cs). The frame paints the window background
         itself, so the effect sees it too. ScreenContent is what gets photographed as "the previous page". -->
    <!-- FIXED (e-ink): both are clipped to their own size. When the toolbar is wider than the window, it runs
         off the right-hand edge; without the clip, the effect treated that overhang as part of the picture
         while the photograph of the previous page did not include it, so during a page turn the old page was
         shown stretched to a different width ("the window changes size for a second"). -->
    <Border x:Name="ScreenFrame" Background="{DynamicResource Base}" ClipToBounds="True">
    <Grid x:Name="ScreenContent" ClipToBounds="True">
    <!-- CHANGED (sketchbook, round 2): PageInset is 0 except in themes that put something down the left edge. -->
    <Grid x:Name="ExplorerShell" Margin="{DynamicResource PageInset}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />   <!-- NEW (experimental themes): the function-key bar -->
        </Grid.RowDefinitions>

        <!-- CHANGED (experimental themes): named, and given a see-through background so the whole strip (not
             just its buttons) counts as "pointer over the toolbar" for the Zen theme's fading toolbar. -->
        <Grid x:Name="ToolbarRow" Grid.Row="0" Margin="10,10,14,8" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE72B;"
                        Command="{Binding BackCommand}" ToolTip="Back  ·  Alt+Left" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72A;"
                        Command="{Binding ForwardCommand}" ToolTip="Forward  ·  Alt+Right" />
                <Button Style="{StaticResource IconButton}" Content="&#xE74A;"
                        Command="{Binding UpCommand}" ToolTip="Up  ·  Alt+Up" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                        Command="{Binding RefreshCommand}" ToolTip="Refresh  ·  F5" />
            </StackPanel>

            <Border x:Name="AddressPill"
                    Grid.Column="1"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource EdgeSunken}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource R9}"
                    Margin="10,0"
                    Height="32">
                <Grid>
                    <ItemsControl x:Name="BreadcrumbBar"
                                  ItemsSource="{Binding Breadcrumbs}"
                                  VerticalAlignment="Center"
                                  Margin="3,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource CrumbButton}"
                                            Content="{Binding Name}"
                                            Tag="{Binding Path}"
                                            Click="OnBreadcrumbClick" />
                                    <TextBlock Text="&#xE76C;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="8"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource InkDisabled}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox x:Name="AddressBox"
                             Style="{StaticResource PlainTextBox}"
                             Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="11,0"
                             Visibility="Collapsed"
                             KeyDown="OnAddressKeyDown"
                             LostFocus="OnAddressLostFocus" />

                    <Border x:Name="AddressActivator"
                            Background="Transparent"
                            Panel.ZIndex="-1"
                            MouseLeftButtonDown="OnAddressActivate" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Border Width="228"
                        Height="32"
                        Margin="0,0,9,0"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource EdgeSunken}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource R9}">
                    <Grid>
                        <TextBlock Text="Search name, tag, or type"
                                   Margin="11,0,34,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource InkFaint}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearch}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource PlainTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="11,0,33,0"
                                 KeyDown="OnSearchKeyDown"
                                 ToolTip="Search by name, tag, or folder type. Prefixes narrow it: tag:work, type:photos, ext:png, is:folder  ·  Ctrl+F" />
                        <Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="&#xE711;"
                                Click="OnClearSearch"
                                ToolTip="Clear search">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Width" Value="26" />
                                    <Setter Property="Height" Value="26" />
                                    <Setter Property="Margin" Value="0,0,3,0" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearch}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
                <ToggleButton Style="{StaticResource IconToggle}"
                              Content="&#xE774;"
                              Margin="0,0,7,0"
                              IsChecked="{Binding SearchEverywhere}"
                              ToolTip="Search everywhere. Looks across every drive rather than just this folder and the folders inside it." />
                <ToggleButton Style="{StaticResource IconToggle}"
                              Content="&#xE8A5;"
                              Margin="0,0,1,0"
                              IsChecked="{Binding SearchFileContents}"
                              IsEnabled="{Binding IsWindowsIndexAvailable}"
                              ToolTip="Search inside files. On, this also finds documents that mention the word; off, it matches file and folder names only, which is faster. Contents are read from the Windows Search index, so it only covers locations Windows has indexed." />
                <!-- REMOVED (toolbar tidy): the "Indexing" text button. The index status chip at the bottom right of
                     the file list opens the same page. -->
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE9F9;" Margin="0,0,7,0"
                        Click="OnDiskUsage" ToolTip="Disk usage · explore indexed file and folder sizes"
                        AutomationProperties.Name="Disk usage" />
                <!-- NEW (folder types, step 2): Git branch and changed-file count in Code folders. -->
                <TextBlock Text="{Binding FolderContextText}"
                           Margin="0,0,9,0"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource InkMuted}"
                           ToolTip="Git branch and the number of changed files in this repository"
                           Visibility="{Binding HasFolderContext, Converter={StaticResource BoolToVisible}}" />
                <Button x:Name="FolderProfileButton"
                        Click="OnFolderProfileButtonClick"
                        ToolTip="{Binding FolderTypeTooltip}"
                        AutomationProperties.Name="{Binding FolderProfileLabel}"
                        Visibility="{Binding CanSetFolderProfile, Converter={StaticResource BoolToVisible}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <!-- CHANGED (folder types, step 3): fits "Auto (Screenshots)" instead of cutting it off. -->
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="MinWidth" Value="96" />
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" Margin="9,0">
                        <TextBlock Text="&#xE8EC;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Accent}" />
                        <TextBlock Text="{Binding FolderProfileLabel}"
                                   FontFamily="{DynamicResource UIFont}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <!-- CHANGED (folder types): filled from the folder type definitions each time it opens. -->
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Opened="OnFolderTypeMenuOpened" />
                    </Button.ContextMenu>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="0,0,7,0"
                            Visibility="{Binding IsGrid, Converter={StaticResource BoolToVisible}}">
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;"
                            Click="OnZoomOut" ToolTip="Smaller tiles  ·  Ctrl+mouse wheel" />
                    <TextBlock Text="{Binding TileZoomText}"
                               Width="42"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="10.5"
                               Foreground="{DynamicResource InkMuted}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;"
                            Click="OnZoomIn" ToolTip="Larger tiles  ·  Ctrl+mouse wheel" />
                </StackPanel>
                <Button x:Name="ColumnsButton"
                        Style="{StaticResource IconButton}"
                        Content="&#xE71D;"
                        Click="OnColumnsButtonClick"
                        ToolTip="Choose columns"
                        Visibility="{Binding IsDetails, Converter={StaticResource BoolToVisible}}">
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding ColumnOptions}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Header}" />
                                    <Setter Property="IsCheckable" Value="True" />
                                    <Setter Property="IsChecked" Value="{Binding IsVisible, Mode=TwoWay}" />
                                    <Setter Property="IsEnabled" Value="{Binding CanToggle}" />
                                    <Setter Property="StaysOpenOnClick" Value="True" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="LayoutButton"
                        Click="OnToggleLayout"
                        ToolTip="Switch between details and tiles  ·  Ctrl+Shift+V">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="&#xE8FD;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGrid}" Value="True">
                                    <Setter Property="Content" Value="&#xE8A9;" />
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE8F4;"
                        Command="{Binding NewFolderCommand}" ToolTip="New folder  ·  Ctrl+Shift+N" />
                <Button Style="{StaticResource IconButton}" Content="&#xE756;"
                        Command="{Binding TerminalCommand}" ToolTip="Open in Terminal  ·  Ctrl+`" />
                <ToggleButton Style="{StaticResource IconToggle}"
                              Content="&#xE7B3;"
                              IsChecked="{Binding ShowHiddenItems}"
                              ToolTip="Show hidden items" />
                <!-- NEW (unlock vs remove lock): settings menu; file locking is its first section. -->
                <Button x:Name="SettingsButton"
                        Style="{StaticResource IconButton}"
                        Content="&#xE713;"
                        Margin="6,0,0,0"
                        Click="OnColumnsButtonClick"
                        ToolTip="Settings"
                        AutomationProperties.Name="Settings">
                    <Button.ContextMenu>
                        <ContextMenu Opened="OnSettingsMenuOpened">
                            <!-- NEW (themes): pick the look. Applies at once to every window and is remembered.
                                 Each item's Tag is a name from ThemeService.Names. -->
                            <MenuItem Header="Theme" IsEnabled="False" />
                            <MenuItem Header="Dark" Tag="Dark" IsCheckable="True" Click="OnThemePicked" />
                            <MenuItem Header="OLED Black" Tag="OLED" IsCheckable="True" Click="OnThemePicked" />
                            <MenuItem Header="Light" Tag="Light" IsCheckable="True" Click="OnThemePicked" />
                            <MenuItem Header="Blueprint" Tag="Blueprint" IsCheckable="True" Click="OnThemePicked" />
                            <MenuItem Header="Terminal" Tag="Terminal" IsCheckable="True" Click="OnThemePicked" />
                            <MenuItem Header="Retro" Tag="Retro" IsCheckable="True" Click="OnThemePicked" />
                            <!-- NEW (experimental themes): these change the icons too, and some add or move things. -->
                            <MenuItem Header="Experimental themes">
                                <MenuItem Header="Pixel" Tag="Pixel" IsCheckable="True" Click="OnThemePicked" />
                                <MenuItem Header="DOS Commander" Tag="DosCommander" IsCheckable="True" Click="OnThemePicked" />
                                <MenuItem Header="Wireframe" Tag="Wireframe" IsCheckable="True" Click="OnThemePicked" />
                                <MenuItem Header="Neon HUD" Tag="NeonHud" IsCheckable="True" Click="OnThemePicked" />
                                <MenuItem Header="Glass" Tag="Glass" IsCheckable="True" Click="OnThemePicked" />
                                <MenuItem Header="Sketchbook" Tag="Sketchbook" IsCheckable="True" Click="OnThemePicked" />
                                <MenuItem Header="Type tiles" Tag="TypeTiles" IsCheckable="True" Click="OnThemePicked" />
                                <MenuItem Header="Zen" Tag="Zen" IsCheckable="True" Click="OnThemePicked" />
                                <MenuItem Header="1-bit Mac" Tag="Mac1Bit" IsCheckable="True" Click="OnThemePicked" />
                                <MenuItem Header="1-bit Mac (dark)" Tag="Mac1BitDark" IsCheckable="True" Click="OnThemePicked" />
                                <!-- CHANGED (e-reader): Paper moved here from the normal themes and renamed. -->
                                <MenuItem Header="E-reader" Tag="Paper" IsCheckable="True" Click="OnThemePicked" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="File locking" IsEnabled="False" />
                            <MenuItem Header="Remove all locks and reset password…" Click="OnRemoveAllLocks" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" MinWidth="170" MaxWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,0,10">
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New category" Click="OnCreateCategory" />
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <ItemsControl ItemsSource="{Binding Sidebar}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="{Binding CollapseGlyph}"
                                        ToolTip="Collapse or expand"
                                        Click="OnToggleSidebarSection"
                                        Grid.Column="1"
                                        Panel.ZIndex="2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Width" Value="25" />
                                            <Setter Property="Height" Value="28" />
                                            <Setter Property="Margin" Value="0,0,8,0" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="{Binding Name}"
                                        ToolTip="Open section"
                                        Grid.Column="0"
                                        Padding="12,0"
                                        Click="OnSidebarClick"
                                        AllowDrop="True"
                                        PreviewMouseLeftButtonDown="OnSidebarMouseDown"
                                        PreviewMouseLeftButtonUp="OnSidebarMouseUp"
                                        PreviewMouseMove="OnSidebarMouseMove"
                                        DragEnter="OnSidebarDragEnter"
                                        DragLeave="OnSidebarDragLeave"
                                        DragOver="OnSidebarDragOver"
                                        Drop="OnSidebarDrop">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="New category" Click="OnCreateCategory">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinnedRoot}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Open hub" Click="OnOpenSectionHub">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasHub}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Rename section" Click="OnRenameCategory">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSection}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Delete category" Click="OnDeleteCategory">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarHeaderButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Tag="{Binding Name}"
                                        ToolTip="{Binding Path}"
                                        Click="OnSidebarClick"
                                        AllowDrop="True"
                                        PreviewMouseLeftButtonDown="OnSidebarMouseDown"
                                        PreviewMouseLeftButtonUp="OnSidebarMouseUp"
                                        PreviewMouseMove="OnSidebarMouseMove"
                                        DragEnter="OnSidebarDragEnter"
                                        DragLeave="OnSidebarDragLeave"
                                        DragOver="OnSidebarDragOver"
                                        Drop="OnSidebarDrop">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="&#xE753;"
                                                       Margin="7,0,0,0"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="9.5"
                                                       Opacity="0.75"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding CloudHint}"
                                                       Visibility="{Binding IsCloudBacked, Converter={StaticResource BoolToVisible}}" />
                                        </StackPanel>
                                    </Button.Content>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Change location…" Click="OnChangeSidebarLocation">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKnownFolder}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Reset to default" Click="OnResetSidebarLocation">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKnownFolder}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Unpin" Click="OnUnpinSidebar">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                    <Setter Property="Padding" Value="30,0,12,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          FocusVisualStyle="{x:Null}" />

            <Border Grid.Column="2"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource EdgeSunken}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource R12}"
                    Margin="0,0,14,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="14,14,14,6"
                            Padding="18,14"
                            Background="{DynamicResource Base}"
                            BorderBrush="{DynamicResource EdgeRaised}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource R10}"
                            Visibility="{Binding IsHub, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding HubTitle}"
                                           FontFamily="{DynamicResource DisplayFont}"
                                           FontSize="23"
                                           Foreground="{DynamicResource Ink}" />
                                <TextBlock Text="{Binding HubDescription}"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource InkMuted}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding HubSummary}"
                                       MaxWidth="330"
                                       Margin="18,4,0,0"
                                       FontFamily="{DynamicResource SerifFont}"
                                       FontSize="13"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Accent}" />
                        </Grid>
                    </Border>

                    <!-- NEW (folder types, step 2): project strip - pinned files and recent work anywhere in the project.
                         Shares row 0 with the hub banner; the two never show together (hubs are not real folders). -->
                    <Border Grid.Row="0"
                            Margin="14,12,14,4"
                            Padding="14,10,14,4"
                            Background="{DynamicResource Base}"
                            BorderBrush="{DynamicResource EdgeRaised}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource R10}"
                            Visibility="{Binding ShowsProjectStrip, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding ProjectTitle}"
                                           FontFamily="{DynamicResource SerifFont}"
                                           FontSize="14"
                                           Foreground="{DynamicResource Ink}" />
                                <TextBlock Text="Pinned and recently changed"
                                           Margin="10,2,0,0"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkMuted}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ProjectStripHint}"
                                       Margin="0,0,0,6"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource InkMuted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding ProjectStrip}" MaxHeight="96">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ProjectChip}"
                                                Margin="0,0,6,6"
                                                MaxWidth="260"
                                                ToolTip="{Binding FullPath}"
                                                Click="OnProjectItemClick">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Open" Click="OnProjectItemOpen" />
                                                    <MenuItem Header="Show in folder" Click="OnProjectItemShowInFolder" />
                                                    <MenuItem Header="Unpin from project"
                                                              Click="OnProjectItemUnpin"
                                                              Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisible}}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="11"
                                                           Margin="0,1,8,0"
                                                           VerticalAlignment="Top"
                                                           Foreground="{DynamicResource Accent}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource InkMuted}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ListView x:Name="FileList"
                              Grid.Row="1"
                              ItemsSource="{Binding Items}"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource Ink}"
                              SelectionMode="Extended"
                              FocusVisualStyle="{x:Null}"
                              SelectionChanged="OnSelectionChanged"
                              MouseDoubleClick="OnItemDoubleClick"
                              PreviewMouseRightButtonDown="OnFileListRightClick"
                              PreviewMouseWheel="OnFileListMouseWheel"
                              PreviewMouseLeftButtonDown="OnFileListPreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnFileListPreviewMouseMove"
                              AllowDrop="True"
                              DragEnter="OnFileListDragOver"
                              DragOver="OnFileListDragOver"
                              DragLeave="OnFileListDragLeave"
                              Drop="OnFileListDrop"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.Style>
                            <Style TargetType="ListView">
                                <Setter Property="View" Value="{StaticResource DetailsView}" />
                                <Setter Property="ItemContainerStyle" Value="{StaticResource FileRow}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMusicProfile}" Value="True">
                                        <Setter Property="AlternationCount" Value="2" />
                                        <Setter Property="ItemContainerStyle" Value="{StaticResource MusicRow}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGrid}" Value="True">
                                        <Setter Property="View" Value="{x:Null}" />
                                        <Setter Property="ItemTemplate" Value="{StaticResource TileTemplate}" />
                                        <Setter Property="ItemsPanel" Value="{StaticResource TilePanel}" />
                                        <Setter Property="ItemContainerStyle" Value="{StaticResource TileContainer}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Style>

                        <!-- NEW (folder types, step 2): date headers (Screenshots). Only used while the view is grouped. -->
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="16,12,0,4"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkMuted}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>

                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                                <Separator />
                                <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                                <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                                <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                                <Separator />
                                <MenuItem Header="Rename" Command="{Binding RenameCommand}" InputGestureText="F2" />
                                <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Del" />
                                <Separator />
                                <!-- CHANGED (folder locking): works on a single file or folder, so the labels no longer say "file". -->
                                <!-- CHANGED (unlock vs remove lock): Unlock = until you leave this folder; Remove lock = for good,
                                     and works on several selected files and folders at once. -->
                                <MenuItem Header="Lock with password…" Click="OnLockFile" IsEnabled="{Binding Context.HasSingleSelection}" />
                                <MenuItem Header="Unlock…" Click="OnUnlockFile" IsEnabled="{Binding Context.HasSingleSelection}" />
                                <MenuItem Header="Remove lock…" Click="OnRemoveLock" IsEnabled="{Binding Context.HasSelection}" />
                                <!-- NEW (change password): switch locked files to your current password. -->
                                <MenuItem Header="Change password…" Click="OnChangeLockPassword" IsEnabled="{Binding Context.HasSelection}" />
                                <Separator />
                                <MenuItem Header="Pin to sidebar" Click="OnPinDirectory" />
                                <!-- NEW (folder types, step 2): Projects folders -->
                                <MenuItem Header="Pin to project"
                                          Click="OnPinToProject"
                                          IsEnabled="{Binding CanPinToProject}"
                                          Visibility="{Binding IsProjectFolder, Converter={StaticResource BoolToVisible}}" />
                                <MenuItem Header="Unpin from project"
                                          Click="OnUnpinFromProject"
                                          IsEnabled="{Binding CanPinToProject}"
                                          Visibility="{Binding IsProjectFolder, Converter={StaticResource BoolToVisible}}" />
                                <MenuItem Header="Disk usage…" Click="OnDiskUsage" />
                                <MenuItem Header="Always keep on this device"
                                          IsEnabled="{Binding HasCloudSelection}"
                                          Visibility="{Binding IsCloudFolder, Converter={StaticResource BoolToVisible}}"
                                          Click="OnKeepOnDevice" />
                                <MenuItem Header="Free up space"
                                          IsEnabled="{Binding HasCloudSelection}"
                                          Visibility="{Binding IsCloudFolder, Converter={StaticResource BoolToVisible}}"
                                          Click="OnFreeUpSpace" />
                                <MenuItem Header="Tags" SubmenuOpened="OnTagsSubmenuOpened">
                                    <MenuItem Header="" />
                                </MenuItem>
                                <!-- CHANGED (folder types): filled from the folder type definitions when opened. -->
                                <MenuItem Header="Set folder type"
                                          IsEnabled="{Binding HasSelectedFolders}"
                                          SubmenuOpened="OnSetFolderTypeSubmenuOpened">
                                    <MenuItem Header="" />
                                </MenuItem>
                                <MenuItem Header="Reset columns" Click="OnResetColumns" />
                                <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" InputGestureText="Ctrl+Shift+C" />
                                <MenuItem Header="Properties" Command="{Binding PropertiesCommand}" InputGestureText="Alt+Enter" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>

                    <Border Grid.Row="1"
                            Background="{DynamicResource Base}"
                            BorderBrush="{DynamicResource EdgeRaised}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource R12}"
                            Padding="30,26"
                            MaxWidth="430"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsAccessDenied, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Accent}" />

                            <TextBlock Text="This folder is protected"
                                       Margin="0,14,0,0"
                                       FontFamily="{DynamicResource DisplayFont}"
                                       FontSize="19"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Ink}" />

                            <TextBlock Text="{Binding AccessDeniedPath}"
                                       Margin="0,8,0,0"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkFaint}" />

                            <TextBlock Margin="0,12,0,0"
                                       FontSize="11.5"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkMuted}"
                                       Text="Windows refused to list its contents. Opening a second window with administrator rights will usually work; a few system paths stay closed to every account." />

                            <Button Content="Open as administrator"
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource ViewerTextButtonPrimary}"
                                    Click="OnOpenElevated"
                                    Visibility="{Binding CanRetryElevated, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource LineFaint}"
                            BorderThickness="0,1,0,0"
                            Padding="16,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Context.LastFileOperation.Message}"
                                       ToolTip="{Binding Context.LastFileOperation.Message}"
                                       Visibility="{Binding Context.HasFileOperationResult, Converter={StaticResource BoolToVisible}}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource InkMuted}" />
                            <TextBlock Text="{Binding StatusText}"
                                       Margin="0,0,110,0"
                                       Foreground="{DynamicResource InkMuted}"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">

                                <Border Background="{DynamicResource Tint}" CornerRadius="{DynamicResource R5}"
                                        Padding="9,3"
                                        Margin="0,0,8,0"
                                        ToolTip="This folder is kept in sync"
                                        Visibility="{Binding IsCloudFolder, Converter={StaticResource BoolToVisible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE753;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource InkMuted}" />
                                        <TextBlock Text="{Binding CloudRootName}"
                                                   Margin="6,0,0,0"
                                                   FontSize="10.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource InkMuted}" />
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource ViewerTextButton}" Background="{DynamicResource Tint}"
                                        Padding="9,3"
                                        Margin="0,0,8,0"
                                        Click="OnIndexing" AutomationProperties.Name="View indexing details" ToolTip="View indexed locations, progress and storage">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8F1;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource InkMuted}" />
                                        <TextBlock Text="{Binding IndexStatusText}"
                                                   Margin="6,0,0,0"
                                                   FontSize="10.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource InkMuted}" />
                                    </StackPanel>
                                </Button>

                                <Border Background="{DynamicResource AccentSoft}"
                                        CornerRadius="{DynamicResource R5}"
                                        Padding="9,3"
                                        Visibility="{Binding IsSearchingTree, Converter={StaticResource BoolToVisible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}" />
                                        <TextBlock Text="Searching…"
                                                   Margin="6,0,0,0"
                                                   FontSize="10.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{DynamicResource Base}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="{DynamicResource RPlayerBar}"
                            Padding="14,10"
                            Visibility="{Binding Player.IsActive, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource TransportButton}"
                                        Content="&#xE892;"
                                        Click="OnPlayerPrevious"
                                        ToolTip="Previous" />
                                <Button Style="{StaticResource PlayButton}"
                                        Content="{Binding Player.PlayGlyph}"
                                        Click="OnPlayerTogglePlay"
                                        ToolTip="Play or pause  ·  Space" />
                                <Button Style="{StaticResource TransportButton}"
                                        Content="&#xE893;"
                                        Click="OnPlayerNext"
                                        ToolTip="Next" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                                <TextBlock Text="{Binding Player.TrackTitle}"
                                           FontFamily="{DynamicResource SerifFont}"
                                           FontSize="13"
                                           Foreground="{DynamicResource Ink}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Player.TrackSubtitle}"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource InkMuted}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Player.PositionText}"
                                           FontFamily="{DynamicResource MonoFont}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkFaint}" />

                                <Slider Grid.Column="1"
                                        Style="{StaticResource MediaSlider}"
                                        Margin="10,0"
                                        Maximum="{Binding Player.DurationSeconds}"
                                        Value="{Binding Player.PositionSeconds, Mode=TwoWay}"
                                        PreviewMouseLeftButtonDown="OnSeekStart"
                                        PreviewMouseLeftButtonUp="OnSeekEnd" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Player.DurationText}"
                                           FontFamily="{DynamicResource MonoFont}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkFaint}" />
                            </Grid>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="&#xE767;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkFaint}" />
                                <Slider Style="{StaticResource MediaSlider}"
                                        Width="84"
                                        Margin="8,0,4,0"
                                        Maximum="1"
                                        Value="{Binding Player.Volume, Mode=TwoWay}" />
                                <Button Style="{StaticResource TransportButton}"
                                        Content="&#xE711;"
                                        Click="OnPlayerStop"
                                        ToolTip="Close player" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="RenamePanel"
                    Grid.Column="2"
                    Visibility="Collapsed"
                    Background="{DynamicResource Overlay}"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource R12}"
                    Padding="18"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Rename"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="16"
                               Margin="0,0,0,12" />
                    <Border Background="{DynamicResource Base}"
                            BorderBrush="{DynamicResource EdgeSunken}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource R8}"
                            Padding="10,8">
                        <TextBox x:Name="RenameBox"
                                 Style="{StaticResource PlainTextBox}"
                                 KeyDown="OnRenameKeyDown" />
                    </Border>
                    <TextBlock Text="Enter to confirm, Esc to cancel"
                               Foreground="{DynamicResource InkFaint}"
                               FontSize="11"
                               Margin="2,10,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="CategoryPanel"
                    Grid.Column="2"
                    Visibility="Collapsed"
                    Background="{DynamicResource Overlay}"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource R12}"
                    Padding="18"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="CategoryPanelTitle"
                               Text="New category"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="16"
                               Margin="0,0,0,12" />
                    <Border Background="{DynamicResource Base}"
                            BorderBrush="{DynamicResource EdgeSunken}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource R8}"
                            Padding="10,8">
                        <TextBox x:Name="CategoryBox"
                                 Style="{StaticResource PlainTextBox}"
                                 KeyDown="OnCategoryKeyDown" />
                    </Border>
                    <TextBlock Text="Enter to save, Esc to cancel"
                               Foreground="{DynamicResource InkFaint}"
                               FontSize="11"
                               Margin="2,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- NEW (experimental themes): the function-key bar of the DOS Commander theme; hidden in every other
             theme. The keys shown are Clearspace's real shortcuts (^ = Ctrl). -->
        <Border Grid.Row="2"
                Background="{DynamicResource BadgeFill}"
                Padding="8,3"
                Visibility="{DynamicResource FunctionKeysVisibility}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource FunctionKey}" Tag="F2" Content="Rename" Command="{Binding RenameCommand}" />
                <Button Style="{StaticResource FunctionKey}" Tag="F5" Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource FunctionKey}" Tag="^C" Content="Copy" Command="{Binding CopyCommand}" />
                <Button Style="{StaticResource FunctionKey}" Tag="^X" Content="Cut" Command="{Binding CutCommand}" />
                <Button Style="{StaticResource FunctionKey}" Tag="^V" Content="Paste" Command="{Binding PasteCommand}" />
                <Button Style="{StaticResource FunctionKey}" Tag="^&#x21E7;N" Content="MkDir" Command="{Binding NewFolderCommand}" />
                <Button Style="{StaticResource FunctionKey}" Tag="Del" Content="Delete" Command="{Binding DeleteCommand}" />
                <Button Style="{StaticResource FunctionKey}" Tag="^`" Content="Shell" Command="{Binding TerminalCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Background="{DynamicResource Scrim}"
                Focusable="True"
                Visibility="{Binding Viewer.IsOpen, Converter={StaticResource BoolToVisible}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Viewer.Title}"
                                   FontFamily="{DynamicResource SerifFont}"
                                   FontSize="15"
                                   Foreground="{DynamicResource Ink}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Viewer.Subtitle}"
                                   FontSize="11"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource InkMuted}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ViewerButton}" Content="&#xE80C;"
                                Click="OnViewerRotateLeft" ToolTip="Rotate left  ·  saves immediately" />
                        <Button Style="{StaticResource ViewerButton}" Content="&#xE80D;"
                                Click="OnViewerRotateRight" ToolTip="Rotate right  ·  saves immediately" />
                        <Button Style="{StaticResource ViewerButton}" Content="&#xE7A8;"
                                Click="OnViewerCrop" ToolTip="Crop" />
                        <Border Width="1" Margin="8,10" Background="{DynamicResource Line}" />
                        <Button Style="{StaticResource ViewerButton}" Content="&#xE71F;"
                                Click="OnViewerZoomOut" ToolTip="Zoom out  ·  &#8722;" />
                        <TextBlock Text="{Binding Viewer.ZoomText}"
                                   MinWidth="46"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource InkMuted}" />
                        <Button Style="{StaticResource ViewerButton}" Content="&#xE8A3;"
                                Click="OnViewerZoomIn" ToolTip="Zoom in  ·  +" />
                        <Button Style="{StaticResource ViewerButton}" Content="&#xE9A6;"
                                Click="OnViewerFit" ToolTip="Fit to window  ·  0" />
                        <Border Width="1" Margin="8,10" Background="{DynamicResource Line}" />
                        <Button Style="{StaticResource ViewerButton}" Content="&#xE711;"
                                Click="OnViewerClose" ToolTip="Close  ·  Esc" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy image" Click="OnViewerCopyImage" InputGestureText="Ctrl+C" />
                            <MenuItem Header="Copy path" Click="OnViewerCopyPath" InputGestureText="Ctrl+Shift+C" />
                            <Separator />
                            <MenuItem Header="Rotate left" Click="OnViewerRotateLeft" />
                            <MenuItem Header="Rotate right" Click="OnViewerRotateRight" />
                            <MenuItem Header="Crop…" Click="OnViewerCrop" />
                            <Separator />
                            <MenuItem Header="Zoom in" Click="OnViewerZoomIn" />
                            <MenuItem Header="Zoom out" Click="OnViewerZoomOut" />
                            <MenuItem Header="Fit to window" Click="OnViewerFit" />
                            <MenuItem Header="Actual size" Click="OnViewerActualSize" />
                            <Separator />
                            <MenuItem Header="Open with…" Click="OnViewerOpenWith" />
                            <MenuItem Header="Show in folder" Click="OnViewerShowInFolder" />
                            <MenuItem Header="Delete" Click="OnViewerDelete" InputGestureText="Del" />
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <ScrollViewer x:Name="ViewerScroll"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  PreviewMouseWheel="OnViewerMouseWheel"
                                  PreviewMouseDown="OnViewerSurfaceMouseDown"
                                  PreviewMouseMove="OnViewerSurfaceMouseMove"
                                  PreviewMouseUp="OnViewerSurfaceMouseUp"
                                  LostMouseCapture="OnViewerSurfaceLostMouseCapture"
                                  PreviewMouseLeftButtonDown="OnViewerSurfaceDown">
                        <Grid x:Name="ViewerStage"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="20">
                            <Image x:Name="ViewerImage"
                                   Source="{Binding Viewer.Image}"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <Canvas x:Name="CropLayer"
                                    Background="#33000000"
                                    Cursor="Cross"
                                    Visibility="{Binding Viewer.IsCropping, Converter={StaticResource BoolToVisible}}"
                                    MouseLeftButtonDown="OnCropDown"
                                    MouseMove="OnCropMove"
                                    MouseLeftButtonUp="OnCropUp">
                                <Border x:Name="CropRectangle"
                                        BorderBrush="{DynamicResource Accent}"
                                        BorderThickness="2"
                                        Background="{DynamicResource AccentWash}"
                                        Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                    </ScrollViewer>

                    <Button Style="{StaticResource ViewerNavButton}"
                            Content="&#xE76B;"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0"
                            Click="OnViewerPrevious"
                            IsEnabled="{Binding Viewer.CanGoPrevious}"
                            ToolTip="Previous  ·  Left" />

                    <Button Style="{StaticResource ViewerNavButton}"
                            Content="&#xE76C;"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0"
                            Click="OnViewerNext"
                            IsEnabled="{Binding Viewer.CanGoNext}"
                            ToolTip="Next  ·  Right" />

                    <TextBlock Text="Loading…"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,14"
                               FontSize="11"
                               Foreground="{DynamicResource InkFaint}"
                               Visibility="{Binding Viewer.IsLoading, Converter={StaticResource BoolToVisible}}" />
                </Grid>

                <Grid Grid.Row="2" Margin="20,8,20,16">
                    <TextBlock Text="{Binding Viewer.Status}"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{DynamicResource InkMuted}"
                               Visibility="{Binding Viewer.HasStatus, Converter={StaticResource BoolToVisible}}" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="{Binding Viewer.IsCropping, Converter={StaticResource BoolToVisible}}">
                        <Button Style="{StaticResource ViewerTextButton}"
                                Content="Cancel"
                                Click="OnCropCancel" />
                        <Button Style="{StaticResource ViewerTextButton}"
                                Content="Save a copy"
                                Click="OnCropSaveCopy"
                                IsEnabled="{Binding Viewer.CanCommitCrop}" />
                        <Button Style="{StaticResource ViewerTextButtonPrimary}"
                                Content="Overwrite"
                                Click="OnCropOverwrite"
                                IsEnabled="{Binding Viewer.CanCommitCrop}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
        <ContentControl x:Name="DiskUsageHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="{DynamicResource PageInset}"/>
        <ContentControl x:Name="IndexingHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="{DynamicResource PageInset}"/>
        <!-- NEW (sketchbook, round 2): the binding strip (Sketchbook's spiral wire). Hidden in every other theme. -->
        <Rectangle Width="30"
                   HorizontalAlignment="Left"
                   Fill="{DynamicResource BindingFill}"
                   Visibility="{DynamicResource BindingVisibility}"
                   IsHitTestVisible="False" />
        <!-- NEW (experimental themes): a see-through pattern over the whole window (Neon HUD's scanlines).
             Clicks pass straight through it; hidden in every other theme. -->
        <Rectangle Fill="{DynamicResource OverlayFill}"
                   Visibility="{DynamicResource OverlayVisibility}"
                   IsHitTestVisible="False" />
    </Grid>
    </Border>
</Window>
