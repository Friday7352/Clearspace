<!-- Clearspace | WPF project settings and dependencies. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <!-- NEW: the disk usage map rasterizes straight into a WriteableBitmap's back buffer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Clearspace</AssemblyName>
    <RootNamespace>Clearspace</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Clearspace.ico</ApplicationIcon>
    <!-- NEW (installer): Clearspace.exe carries the version from the VERSION file at the repository root,
         the same number the installer shows. Without the file (e.g. a copy of this folder alone) the
         SDK's default 1.0.0 is used. -->
    <Version Condition="Exists('$(MSBuildThisFileDirectory)..\VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</Version>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Data.OleDb" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Clearspace.ico" />
    <!-- NEW (pixel font): the Pixel theme's fonts, built into the app so they need no installing. Both are
         under the SIL Open Font License; the licence texts sit beside them in Assets\Fonts. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- NEW (Explorer integration): lock icons Clearspace writes out for Explorer (.cslock files, locked folders). -->
    <EmbeddedResource Include="Assets\LockedFile.ico" LogicalName="Clearspace.LockedFile.ico" />
    <EmbeddedResource Include="Assets\LockedFolder.ico" LogicalName="Clearspace.LockedFolder.ico" />
    <InternalsVisibleTo Include="Clearspace.Tests" />
  </ItemGroup>

  <!-- NEW (memory): let the garbage collector compact large arrays when free space builds up between
       them, instead of growing the process to make room. Costs a little speed during big rebuilds. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

</Project>
