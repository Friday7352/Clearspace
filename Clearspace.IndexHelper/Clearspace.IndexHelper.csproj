<!-- Clearspace | Optional index helper service: reads NTFS change journals for Clearspace. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ClearspaceIndexHelper</AssemblyName>
    <RootNamespace>Clearspace.IndexHelper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- NEW (logo): the helper had no icon, so Task Manager and Explorer showed it as a blank program. -->
    <ApplicationIcon>..\Clearspace\Assets\Clearspace.ico</ApplicationIcon>
    <!-- NEW (installer): same version number as Clearspace.exe and the installer (the VERSION file). -->
    <Version Condition="Exists('$(MSBuildThisFileDirectory)..\VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</Version>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- One file, so installing the service copies a single executable to Program Files. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>

  <!-- NEW (memory): let the garbage collector compact large arrays when free space builds up between
       them, instead of growing the process to make room. Costs a little speed during big rebuilds. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <!-- The journal reader and protocol are shared with Clearspace; they use only the base class library. -->
  <ItemGroup>
    <Compile Include="..\Clearspace\Journal\*.cs" Link="Journal\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
